@{ViewData["Title"]="Interactive risk map";}
<section class="intro"><div><small>GEOSPATIAL INTELLIGENCE / INDIA</small><h2>Explore water-risk signals across India.</h2><p>Explore illustrative monitoring locations across multiple states. Select a marker for its sample details.</p></div><span class="chip">15 DEMO LOCATIONS · INDIA</span></section>
<div class="map-toolbar"><input id="zoneSearch" placeholder="Search city, state or monitoring zone..."><select id="riskFilter"><option value="all">All risk levels</option><option value="High">High</option><option value="Moderate">Moderate</option><option value="Low">Routine</option></select><button type="button" onclick="resetMap()">Reset India view</button></div>
<div class="map-layout"><section class="panel"><div id="fullMap" class="map bigmap"></div><div class="legend"><span><i class="high"></i> High signal</span><span><i class="medium"></i> Moderate signal</span><span><i class="low"></i> Routine</span></div></section>
<aside class="panel zone-detail"><small>SELECTED MONITORING LOCATION</small><h3 id="zoneTitle">Choose a map marker</h3><p id="zoneDescription">Select any marker across India to inspect its illustrative readings.</p>
<div class="zone-metric"><small>RISK INDICATOR</small><b id="zoneRisk">—</b></div><div class="zone-metric"><small>WATER SAMPLE</small><b id="zoneWater">—</b></div><div class="zone-metric"><small>COMMUNITY SIGNAL</small><b id="zoneCases">—</b></div><a asp-controller="Home" asp-action="Predict" class="button full">Open prediction lab ↗</a>
<div class="notice">All markers and sample values are synthetic demonstration data, not confirmed contamination or outbreak reports.</div></aside></div>